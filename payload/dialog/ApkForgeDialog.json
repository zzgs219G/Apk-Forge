{
  // ApkForge 本地弹窗配置
  // ─────────────────────────────────────────────
  // 这份文件会被放进宿主的 assets/apkforge_dialog.json。
  // 载荷只读它，不会联网。改完重新注入即可生效。
  //
  // 开关只有「开」「关」两种值；颜色可写 #rrggbb 或 #aarrggbb，
  // 写错会被忽略（退回宿主主题默认色），不会让弹窗失败。
  // ─────────────────────────────────────────────

  "总开关": "开",
  "点击外部关闭": "关",
  "标题": "ApkForge 提示",
  "标题颜色": "#4da3ff",
  "信息": "这段弹窗由 ApkForge 注入，配置就在 <b>assets/apkforge_dialog.json</b>。<br>改文案不需要重新编译 dex。",
  "信息颜色": "#c8c8c8",

  // 位置：0=左（确定）1=右（取消）2=中
  // 动作：none 关闭 / url 打开网页 / exit 退出宿主 / custom 自定义 scheme
  "按钮": [
    {
      "位置": 0,
      "文本": "知道了",
      "动作": "none"
    },
    {
      "位置": 1,
      "文本": "查看项目",
      "动作": "url",
      "参数": "https://cnb.cool/zzgs219/Apk-Forge",
      "提示": "正在打开浏览器"
    }
  ]
}
