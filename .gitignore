# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# 本地配置（含绝对路径，不入库）
local.properties

# IDE
.idea/
*.iml
.kotlin/

# 系统
.DS_Store
Thumbs.db

# 构建产物
*.apk
*.aab
*.ap_
*.dex
!app/src/main/assets/sample/*.dex
# 弹窗载荷的 dex 是**构建产物但必须入库**：App 运行时要从 assets 读它，
# 而 CI 里不保证有 build-tools（d8）。改了 payload/ 源码要重新跑 build.sh 并提交这个文件。
!app/src/main/assets/plugin/*.dex

# 示例 payload 的中间产物（源码在 tools/sample-payload/src，dex 在 assets）
tools/sample-payload/build/

# 弹窗载荷的中间产物与输出（源码在 payload/dialog/src，dex 已随 assets 入库）
payload/dialog/build/
payload/dialog/out/

# 日志
*.log
build-log/

# CI 产物与签名（密钥绝不入库）
dist/
dist-*/
release.keystore
release.properties
*.keystore
